# Copy to .env.local for development. NEVER commit a filled-in copy.
#
# BUG A5 (fixed): this file used to omit CRON_SECRET entirely — so the cron
# route 500'd on a fresh deploy with no clue why — and it shipped the reference
# business's owner/repo as DEFAULTS, which is how a clone ends up pointing at
# somebody else's repository (bug A4). Identity vars are blank here on purpose.

# --- GitHub -----------------------------------------------------------------
# PAT with `repo` + `workflow` scopes. Server-side only; never exposed to the
# browser (R18).
GH_TOKEN=

# Identity. NO DEFAULTS — the app throws if these are unset, which is the point.
GH_OWNER=
GH_REPO=

# --- Auth -------------------------------------------------------------------
# Single shared dashboard password (compared with a constant-time helper).
DASHBOARD_PASSWORD=

# REQUIRED in production; the app refuses to boot without it. Minimum 32 chars.
#   openssl rand -base64 32
SESSION_SECRET=

# --- Cron -------------------------------------------------------------------
# Vercel sends this as `Authorization: Bearer $CRON_SECRET` on scheduled
# invocations. Without it /api/cron/publish returns 500 on every run — and
# because the cron is the thing that publishes, that failure is silent.
#   openssl rand -base64 32
CRON_SECRET=

# --- Optional ---------------------------------------------------------------
# Dead-man's switch. Pinged only on a SUCCESSFUL publish, so "nothing ran at
# all" alerts too (R5). Sentry Cron Monitor or Healthchecks.io.
HEARTBEAT_URL=
